<% if google_sign_in_enabled? %>
  <div class="divider"><%= t("auth.or") %></div>
  <%= button_to "/auth/google_oauth2",
        data:  { turbo: false },
        class: "btn w-full h-12 text-base border border-hairline text-ink hover:bg-surface-card flex items-center justify-center gap-2 cursor-pointer" do %>
    <svg class="w-4 h-4" viewBox="0 0 24 24" aria-hidden="true">
      <path fill="#4285F4" d="M23.5 12.27c0-.85-.08-1.66-.22-2.45H12v4.64h6.46a5.53 5.53 0 0 1-2.4 3.62v3h3.88c2.27-2.1 3.56-5.17 3.56-8.81z"/>
      <path fill="#34A853" d="M12 24c3.24 0 5.96-1.07 7.94-2.91l-3.88-3c-1.08.72-2.45 1.15-4.06 1.15-3.13 0-5.78-2.11-6.72-4.95H1.27v3.1A12 12 0 0 0 12 24z"/>
      <path fill="#FBBC05" d="M5.28 14.29a7.2 7.2 0 0 1 0-4.58v-3.1H1.27a12 12 0 0 0 0 10.78l4.01-3.1z"/>
      <path fill="#EA4335" d="M12 4.76c1.76 0 3.34.6 4.59 1.8l3.44-3.45A11.98 11.98 0 0 0 1.27 6.6l4.01 3.1C6.22 6.88 8.87 4.76 12 4.76z"/>
    </svg>
    <%= t("auth.continue_with_google") %>
  <% end %>
<% end %>
